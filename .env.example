# Public browser values only. Never put a Supabase secret/service key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Canonical public origin, without a trailing slash. If unset, SEO output uses the
# Cloudflare Pages project URL with noindex enabled until your final domain is chosen.
# Set this to the final HTTPS domain to enable indexing and stable canonicals.
# VITE_SITE_URL=https://your-final-domain.example
